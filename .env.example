# JobFinder v2.3.0 — copie para .env e substitua os valores fictícios
NODE_ENV=development
GEMINI_API_KEY=SUA_CHAVE_GEMINI
TELEGRAM_BOT_TOKEN=SEU_TOKEN_TELEGRAM
TELEGRAM_CHAT_ID=SEU_CHAT_ID

# Backend de persistência dos históricos: json (padrão, local) ou postgres (Supabase).
# No modo postgres não há fallback para json: falhas do banco interrompem o envio.
JOBFINDER_STORAGE=json

# Limite base de novas análises Gemini por execução: 5 (padrão) até 10.
# Com o controle de cota ativo, este valor é o PISO do limite efetivo: o limite
# é ampliado pelo orçamento de requisições da execução (ver variáveis abaixo).
JOBFINDER_MAX_ANALYSES=5

# Vagas enviadas por requisição ao Gemini (generateContent, não a Batch API):
# padrão 5, teto de 10. É INDEPENDENTE de JOBFINDER_MAX_ANALYSES; cada lote é
# ainda limitado ao saldo de novas análises da execução.
JOBFINDER_ANALYSIS_BATCH_SIZE=5

# Controle persistente da cota gratuita do Gemini (compartilhada entre execuções).
# Padrão 450 requisições/dia; a renovação ocorre à meia-noite de America/Los_Angeles.
# A cota é limitada ao TETO operacional seguro de 450 RPD (valores maiores são reduzidos).
JOBFINDER_GEMINI_DAILY_QUOTA=450
# Execuções programadas por dia (cron horário = 24): base da distribuição do
# orçamento diário. O saldo não utilizado é absorvido pelas execuções seguintes.
JOBFINDER_GEMINI_EXECUTIONS_PER_DAY=24
# Intervalo mínimo (ms) entre requisições ao Gemini, compartilhado entre execuções
# (padrão 6000 = 6 s; 0 desativa fora de produção). Em produção (NODE_ENV=production)
# o intervalo é elevado ao piso de 6000 ms.
JOBFINDER_GEMINI_MIN_INTERVAL_MS=6000
# Limite conservador de tokens de entrada por minuto (TPM), considerando o prompt
# completo (instrução de sistema + lote). Padrão 250000, limitado ao teto de 250000.
JOBFINDER_GEMINI_TPM_LIMIT=250000
# Orçamento (ms) da fase de análise, contado DESDE O INÍCIO DO PIPELINE (coleta e
# esperas inclusas); padrão 480000 = 8 min, abaixo do timeout de 10 min do Actions.
JOBFINDER_GEMINI_TIME_BUDGET_MS=480000

# Orçamento (em caracteres) da descrição enviada à IA. Substitui o truncamento
# fixo de 4000 caracteres. Aceita apenas inteiro positivo (somente dígitos);
# valores inválidos mantêm o padrão de 4000.
JOBFINDER_ANALYSIS_DESCRIPTION_BUDGET=4000

# Nenhuma notificação é enviada quando false
JOBFINDER_SEND_NOTIFICATIONS=false

# Só vale com JOBFINDER_SEND_NOTIFICATIONS=true
JOBFINDER_SEND_REVIEWS=false

# Limite de notificações por execução: padrão 3, teto de 10. As vagas
# compatíveis são enviadas antes das de revisão manual, respeitando a ordem de
# prioridade dentro de cada grupo. Apenas envios aceitos consomem o limite.
JOBFINDER_MAX_NOTIFICATIONS=3

# Fila persistente de vagas pendentes entre execuções (JSON em
# data/pending-jobs.json ou tabela public.pending_jobs). Persiste as vagas
# elegíveis que não puderam ser concluídas (limite de análises, indisponibilidade
# da IA/orçamento de tempo) ou que ficaram sem notificação apenas pelo limite de
# envios, recuperando-as nas execuções seguintes — inclusive sem nova coleta.
# Habilita/desabilita a fila (padrão true).
JOBFINDER_PENDING_JOBS_ENABLED=true
# Idade máxima (dias) de uma pendência antes de ser tratada como obsoleta
# (padrão 7, mínimo 1).
JOBFINDER_PENDING_JOB_TTL_DAYS=7
# Teto de pendências persistidas; excedido, as mais antigas são descartadas
# (padrão 200, mínimo 1).
JOBFINDER_PENDING_MAX_JOBS=200

# Controle do job AGENDADO no GitHub Actions (variável de repositório, não do .env).
# Não afeta a execução local. Mantenha desativado até validar o fluxo; a execução
# manual (workflow_dispatch) continua disponível independentemente deste valor.
JOBFINDER_AUTOMATION_ENABLED=false

# Conexão PostgreSQL do Supabase (obrigatória apenas no modo postgres).
# Nunca versionar credenciais reais. Parâmetros de SSL na URL (sslmode, ssl*)
# são ignorados: a validação TLS é fixada no código.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Caminho do certificado CA (opcional). Sem ele, a validação TLS usa as CAs
# confiáveis do sistema. O certificado público do Supabase já está em
# certs/prod-ca-2021.crt. Nunca versionar certificados privados.
DATABASE_CA_CERT_PATH=./certs/prod-ca-2021.crt

# Execução de testes que gravam no banco (opt-in; ver scripts/test-postgres-storage.mjs).
JOBFINDER_RUN_DB_TESTS=false
