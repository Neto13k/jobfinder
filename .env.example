# JobFinder v1.0 — copie para .env e substitua os valores fictícios
NODE_ENV=development
GEMINI_API_KEY=SUA_CHAVE_GEMINI
TELEGRAM_BOT_TOKEN=SEU_TOKEN_TELEGRAM
TELEGRAM_CHAT_ID=SEU_CHAT_ID

# Novas análises Gemini por execução: 1 (padrão) até 5
JOBFINDER_MAX_ANALYSES=1

# Nenhuma notificação é enviada quando false
JOBFINDER_SEND_NOTIFICATIONS=false

# Só vale com JOBFINDER_SEND_NOTIFICATIONS=true
JOBFINDER_SEND_REVIEWS=false

# Conexão PostgreSQL do Supabase (backend). Nunca versionar credenciais reais.
# Parâmetros de SSL na URL (sslmode, ssl*) são ignorados: a validação TLS é fixada no código.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Caminho do certificado CA do Supabase (opcional). Sem ele, a validação TLS
# usa as CAs confiáveis do sistema. Nunca versionar certificados privados.
DATABASE_CA_CERT_PATH=
