# JobFinder v1.1 — copie para .env e substitua os valores fictícios
NODE_ENV=development
GEMINI_API_KEY=SUA_CHAVE_GEMINI
TELEGRAM_BOT_TOKEN=SEU_TOKEN_TELEGRAM
TELEGRAM_CHAT_ID=SEU_CHAT_ID

# Backend de persistência dos históricos: json (padrão, local) ou postgres (Supabase).
# No modo postgres não há fallback para json: falhas do banco interrompem o envio.
JOBFINDER_STORAGE=json

# Novas análises Gemini por execução: 1 (padrão) até 5
JOBFINDER_MAX_ANALYSES=1

# Nenhuma notificação é enviada quando false
JOBFINDER_SEND_NOTIFICATIONS=false

# Só vale com JOBFINDER_SEND_NOTIFICATIONS=true
JOBFINDER_SEND_REVIEWS=false

# Controle do job AGENDADO no GitHub Actions (variável de repositório, não do .env).
# Não afeta a execução local. Mantenha desativado até validar o fluxo; a execução
# manual (workflow_dispatch) continua disponível independentemente deste valor.
JOBFINDER_AUTOMATION_ENABLED=false

# Conexão PostgreSQL do Supabase (obrigatória apenas no modo postgres).
# Nunca versionar credenciais reais. Parâmetros de SSL na URL (sslmode, ssl*)
# são ignorados: a validação TLS é fixada no código.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Caminho do certificado CA (opcional). Sem ele, a validação TLS usa as CAs
# confiáveis do sistema. O certificado público do Supabase já está em
# certs/prod-ca-2021.crt. Nunca versionar certificados privados.
DATABASE_CA_CERT_PATH=./certs/prod-ca-2021.crt

# Execução de testes que gravam no banco (opt-in; ver scripts/test-postgres-storage.mjs).
JOBFINDER_RUN_DB_TESTS=false
