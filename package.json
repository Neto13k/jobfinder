{
  "name": "jobfinder",
  "version": "1.1.0",
  "description": "Bot de busca de vagas de tecnologia que utiliza APIs e inteligência artificial para identificar oportunidades compatíveis com o perfil profissional e enviar notificações pelo Telegram.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node scripts/test-filters.mjs && node scripts/test-storage.mjs && node scripts/test-dispatch.mjs",
    "test:db": "npm run build && node --env-file=.env scripts/test-postgres-storage.mjs",
    "db:migrate": "npm run build && node --env-file=.env scripts/migrate-json-to-postgres.mjs",
    "db:migrate:dry": "npm run build && node --env-file=.env scripts/migrate-json-to-postgres.mjs --dry-run",
    "notifications:pending": "npm run build && node --env-file=.env scripts/recover-pending-notifications.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neto13k/jobfinder.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Neto13k/jobfinder/issues"
  },
  "homepage": "https://github.com/Neto13k/jobfinder#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "pg": "^8.23.1"
  }
}
